# Server-side Gemini API Key
# Optional: Only required if using live Google Gemini cloud API via /api/diagnose.
# When omitted, MechMate runs seamlessly using the built-in deterministic mechatronic engine at zero operating cost.
# NOTE: Never prefix with VITE_ to prevent bundling secrets into the public client bundle!
GEMINI_API_KEY=your_gemini_api_key_here
